rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /payments/{id} {
      allow read: if true;
      allow create: if request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 0
                    && request.resource.data.studentName.size() < 100
                    && request.resource.data.className is string
                    && request.resource.data.paymentType in ['day','week','term']
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount < 5000;
      allow delete: if true;
      allow update: if false;
    }

    match /config/settings {
      allow read: if true;
      allow write: if request.resource.data.feePerDay is number
                   && request.resource.data.daysPerWeek is int
                   && request.resource.data.weeksPerTerm is int;
    }
  }
}
